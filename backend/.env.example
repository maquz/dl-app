# Copy this file to .env and adjust values

# Port the API server listens on
PORT=4000

# Path to the SQLite database file (created automatically on first run)
DB_PATH=./data/registrations.db

# Password required to access the admin dashboard API endpoints
# Change this to something strong before deploying!
ADMIN_PASSWORD=change-me-please

# Allowed origin for CORS (your frontend URL). Use * only for local dev.
CORS_ORIGIN=http://localhost:5173
